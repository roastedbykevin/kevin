{
  "name": "kevin-desktop",
  "productName": "Kevin",
  "version": "0.2.5",
  "description": "Desktop Kevin: the riff comic from roastedbykevin.com, small, on your screen.",
  "main": "main.js",
  "license": "SEE LICENSE IN LICENSE-KEVIN",
  "author": "roastedbykevin",
  "homepage": "https://roastedbykevin.com",
  "scripts": {
    "start": "electron .",
    "smoke": "node smoke.js",
    "smoke:media": "node smoke.js media",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "smoke:wake": "node smoke.js wake",
    "test:wake": "node test/wake.test.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.roastedbykevin.kevin",
    "productName": "Kevin",
    "files": [
      "main.js",
      "media.js",
      "preload.js",
      "ear.html",
      "ear.js",
      "ear-preload.js",
      "wake.js",
      "models/*.onnx",
      "tray.png",
      "tray-16.png",
      "!node_modules/**/*",
      "node_modules/onnxruntime-web/package.json",
      "node_modules/onnxruntime-web/dist/ort.wasm.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "Kevin-Desktop-mac.dmg",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Kevin hears you only while you hold Talk, or, if you turn it on, listens on this computer for 'Hey Kevin'.",
        "NSAppleEventsUsageDescription": "Kevin reads only the title and play state from the media apps you allow, to riff along."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kevin-Desktop-win.exe"
    },
    "dmg": {
      "sign": true
    }
  },
  "dependencies": {
    "onnxruntime-web": "1.20.1"
  }
}
